# 服务端口
PORT=3000

# MongoDB 连接串
#  - 宿主机直接 npm 运行：用 localhost（需本机已有 MongoDB）
#  - Docker Compose 运行：会被 compose 自动覆盖为 mongodb://mongo:27017/...，此处不用改
# 注意：主机名 "mongo" 只在 Docker 网络内可解析，宿主机上直接用会报 ENOTFOUND mongo
MONGODB_URI=mongodb://localhost:27017/order_food

# 启动时自动导入种子数据（幂等）。Docker 部署建议 true，省去手动 seed
AUTO_SEED=false

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 微信小程序凭证（用于 code2session 换取 openid）
WX_APPID=your-wx-appid
WX_SECRET=your-wx-appsecret

# 本地联调开关：为 true 时允许用 mockOpenid 跳过微信登录（生产务必 false）
ALLOW_MOCK_LOGIN=false

# 国产大模型（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# 接口限流（按 IP+openid 计数，窗口内超限返回 429）
RATE_WINDOW_MS=60000   # 时间窗口（毫秒）
RATE_API_MAX=120       # 全局接口上限/窗口
RATE_LOGIN_MAX=10      # 登录接口上限/窗口（防爆破）
RATE_AI_MAX=10         # AI 接口上限/窗口（控成本）
