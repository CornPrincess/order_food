# 服务端口
PORT=3000

# MongoDB 连接串（Docker compose 内默认指向 mongo 服务）
MONGODB_URI=mongodb://mongo:27017/order_food

# JWT 签名密钥（务必改成随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 微信小程序凭证（用于 code2session 换取 openid）
WX_APPID=your-wx-appid
WX_SECRET=your-wx-appsecret

# 本地联调开关：为 true 时允许用 mockOpenid 跳过微信登录（生产务必 false）
ALLOW_MOCK_LOGIN=false

# 国产大模型（DeepSeek，OpenAI 兼容接口）
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
