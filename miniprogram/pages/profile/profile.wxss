.fam-name { font-size: 36rpx; font-weight: 700; }
.invite { text-align: right; }
.invite-code {
  font-size: 36rpx; font-weight: 700; color: var(--primary);
  letter-spacing: 4rpx;
}

.members { display: flex; flex-wrap: wrap; margin-top: 28rpx; gap: 28rpx; }
.member { text-align: center; width: 110rpx; }
.avatar {
  width: 80rpx; height: 80rpx; line-height: 80rpx; margin: 0 auto 8rpx;
  background: var(--primary-light); color: var(--primary);
  border-radius: 50%; font-size: 32rpx; font-weight: 600;
}
.member-name { font-size: 24rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.member-role { font-size: 22rpx; }

.field { background: var(--bg); border-radius: 12rpx; padding: 22rpx; margin-top: 12rpx; }
.mt { margin-top: 32rpx; }
.mt-sm { margin-top: 12rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip {
  padding: 12rpx 28rpx; border-radius: 999rpx;
  background: var(--bg); color: var(--text-secondary);
}
.chip.on { background: var(--primary); color: #fff; }
.chip.on-warn { background: var(--warning); color: #fff; }
.hint { text-align: center; margin-top: 20rpx; }

.share-btn {
  margin-top: 28rpx; width: 100%;
  background: var(--primary-light); color: var(--primary);
  border-radius: 12rpx; font-size: 28rpx; line-height: 2.6;
}
.share-btn::after { border: none; }
.share-icon { margin-right: 8rpx; }
