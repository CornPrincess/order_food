<view class="container">
  <view wx:if="{{picker}}" class="picker-banner">点击菜品加入今日{{meal}}餐</view>

  <view class="search">
    <input class="search-input" placeholder="搜索菜名" value="{{keyword}}"
      bindinput="onSearch" confirm-type="search" bindconfirm="doSearch" />
    <view class="search-btn" bindtap="doSearch">搜索</view>
  </view>

  <scroll-view scroll-x class="cuisine-bar">
    <view class="cuisine {{cuisine===item?'active':''}}" wx:for="{{cuisines}}" wx:key="*this"
      data-c="{{item}}" bindtap="pickCuisine">{{item}}</view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading">加载中…</view>
  <view wx:elif="{{!recipes.length}}" class="empty">没有找到菜谱</view>

  <view class="recipe-card" wx:for="{{recipes}}" wx:key="_id"
    data-id="{{item._id}}" data-item="{{item}}" bindtap="onTapRecipe">
    <view class="row-between">
      <view class="recipe-name">{{item.name}}</view>
      <view class="muted">{{item.cookTime}}分钟 · {{item.difficulty}}</view>
    </view>
    <view class="muted recipe-cuisine">{{item.cuisine}}</view>
    <view class="warn-line" wx:if="{{item.conflicts.length}}">
      <text wx:if="{{item.hasAllergy}}" class="warn warn-allergy">⚠ 过敏原：{{item.allergyHits}}</text>
      <text wx:if="{{item.dislikeHits.length}}" class="warn warn-dislike">家人忌口：{{item.dislikeHits}}</text>
    </view>
    <view class="tags">
      <text class="tag" wx:for="{{item.tasteTags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
      <text class="tag tag-muted" wx:for="{{item.nutritionTags}}" wx:for-item="n" wx:key="*this">{{n}}</text>
      <text wx:if="{{item.source==='ai'}}" class="tag ai-tag">AI</text>
    </view>
  </view>
</view>
