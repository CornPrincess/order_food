.picker-banner {
  background: var(--primary-light); color: var(--primary);
  padding: 16rpx 24rpx; border-radius: 12rpx; margin-bottom: 20rpx;
  font-size: 26rpx; text-align: center;
}
.search { display: flex; gap: 16rpx; margin-bottom: 20rpx; }
.search-input {
  flex: 1; background: #fff; border-radius: 999rpx; padding: 18rpx 28rpx;
}
.search-btn {
  background: var(--primary); color: #fff; border-radius: 999rpx;
  padding: 18rpx 36rpx; font-size: 28rpx;
}
.cuisine-bar { white-space: nowrap; margin-bottom: 20rpx; }
.cuisine {
  display: inline-block; padding: 12rpx 32rpx; margin-right: 16rpx;
  background: #fff; border-radius: 999rpx; color: var(--text-secondary);
}
.cuisine.active { background: var(--primary); color: #fff; }

.recipe-card {
  background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.recipe-name { font-size: 32rpx; font-weight: 600; }
.recipe-cuisine { margin: 8rpx 0 16rpx; }
.tags { display: flex; flex-wrap: wrap; }
.ai-tag { background: #fff1e6; color: var(--warning); }
