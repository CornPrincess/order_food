.intro { text-align: center; padding: 48rpx 28rpx; }
.intro-emoji { font-size: 88rpx; }
.intro-title { font-size: 36rpx; font-weight: 700; margin: 16rpx 0 12rpx; }
.intro-sub { margin-bottom: 32rpx; }
.gen-btn.disabled { opacity: 0.6; }

.rec-name { font-size: 34rpx; font-weight: 600; }
.reason {
  background: #fff8ef; color: var(--warning);
  padding: 16rpx 20rpx; border-radius: 12rpx; margin: 16rpx 0;
  font-size: 26rpx;
}
.tags { display: flex; flex-wrap: wrap; margin-top: 8rpx; }
.actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.act-ghost {
  flex: 1; text-align: center; padding: 18rpx 0;
  color: var(--primary); background: var(--primary-light); border-radius: 999rpx;
}
.act-primary {
  flex: 1; text-align: center; padding: 18rpx 0;
  color: #fff; background: var(--primary); border-radius: 999rpx;
}
