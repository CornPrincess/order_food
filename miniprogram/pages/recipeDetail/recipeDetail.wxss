.title { font-size: 40rpx; font-weight: 700; }
.meta { margin: 12rpx 0 16rpx; }
.tags { display: flex; flex-wrap: wrap; }
.ingredient { padding: 10rpx 0; color: var(--text); }
.step { display: flex; padding: 14rpx 0; }
.step-no {
  flex-shrink: 0; width: 44rpx; height: 44rpx; line-height: 44rpx;
  text-align: center; background: var(--primary); color: #fff;
  border-radius: 50%; font-size: 24rpx; margin-right: 20rpx;
}
.step-text { flex: 1; line-height: 44rpx; }
