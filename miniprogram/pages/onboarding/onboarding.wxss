.hero {
  text-align: center;
  padding: 60rpx 0 40rpx;
}
.hero-emoji { font-size: 96rpx; }
.hero-title { font-size: 44rpx; font-weight: 700; margin-top: 16rpx; }
.hero-sub { color: var(--text-secondary); margin-top: 12rpx; }

.tabs {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  color: var(--text-secondary);
}
.tab.active {
  background: var(--primary);
  color: #fff;
  font-weight: 600;
}

.field-label { font-size: 26rpx; color: var(--text-secondary); margin: 20rpx 0 12rpx; }
.field {
  background: var(--bg);
  border-radius: 12rpx;
  padding: 22rpx;
  margin-bottom: 12rpx;
}
.btn-primary { margin-top: 32rpx; }
.tip { text-align: center; margin-top: 32rpx; }
